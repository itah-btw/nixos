{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#cdd6f4",
    "margin": 2
  },
  "block_quote": {
    "color": "#a6adc8",
    "indent": 1,
    "indent_token": "▍ "
  },
  "paragraph": {
    "color": "#cdd6f4"
  },
  "list": {
    "color": "#cdd6f4",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#cba6f7",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "#cba6f7",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#89b4fa"
  },
  "h3": {
    "prefix": "### ",
    "color": "#94e2d5"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#f5c2e7"
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### "
  },
  "text": {
    "color": "#cdd6f4"
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#a6adc8"
  },
  "strong": {
    "bold": true,
    "color": "#f9e2af"
  },
  "hr": {
    "color": "#6c7086",
    "format": "\n────────────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#89b4fa"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#89b4fa",
    "underline": true
  },
  "link_text": {
    "color": "#89b4fa"
  },
  "image": {
    "color": "#fab387"
  },
  "image_text": {
    "color": "#a6adc8"
  },
  "code": {
    "color": "#f5c2e7"
  },
  "code_block": {
    "color": "#f9e2af",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#cdd6f4"
      },
      "comment": {
        "color": "#6c7086"
      },
      "keyword": {
        "color": "#89b4fa"
      },
      "literal_string": {
        "color": "#a6e3a1"
      },
      "literal_number": {
        "color": "#fab387"
      },
      "name_function": {
        "color": "#94e2d5"
      },
      "name_tag": {
        "color": "#f5c2e7"
      },
      "name_type": {
        "color": "#cba6f7"
      },
      "operator": {
        "color": "#cba6f7"
      },
      "punctuation": {
        "color": "#bac2de"
      },
      "background": {
        "background_color": "#181825"
      }
    }
  },
  "table": {
    "margin": 1
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}